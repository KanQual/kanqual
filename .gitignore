# Platform-specific PostgreSQL runtimes are staged locally for packaging.
src-tauri/postgres-runtimes/postgresql-17/**/*
!src-tauri/postgres-runtimes/README.md
!src-tauri/postgres-runtimes/postgresql-17/
!src-tauri/postgres-runtimes/postgresql-17/*/
!src-tauri/postgres-runtimes/postgresql-17/*/.gitkeep
src-tauri/resources/runtime/postgresql-17/**/*
!src-tauri/resources/runtime/postgresql-17/
!src-tauri/resources/runtime/postgresql-17/README.md
!src-tauri/resources/runtime/postgresql-17/bin/
!src-tauri/resources/runtime/postgresql-17/bin/.gitkeep
!src-tauri/resources/runtime/postgresql-17/lib/
!src-tauri/resources/runtime/postgresql-17/lib/.gitkeep
!src-tauri/resources/runtime/postgresql-17/share/
!src-tauri/resources/runtime/postgresql-17/share/.gitkeep
