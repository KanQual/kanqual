{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanqual",
  "version": "0.9.0",
  "identifier": "com.kanqual.app",
  "build": {
    "beforeDevCommand": "node scripts/dev-with-cleanup.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "Kanqual",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      },
      {
        "create": false,
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 420,
        "height": 320,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon2.ico"
    ],
    "externalBin": ["binaries/local/pocketbase"]
  }
}
